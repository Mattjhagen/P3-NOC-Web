[Unit]
Description=P3 NOC Bitcoin Intelligence Dashboard
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=matty
WorkingDirectory=/opt/p3-noc

# Run dashboard directly on the primary physical terminal display (/dev/tty1)
# Note: For this to work, StandardInput/Output/Error must be bound to tty
ExecStart=/usr/bin/python3 dashboard.py --wallboard
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

# Environment setup
Environment=TERM=xterm-256color
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
Environment=DATABASE_URL=postgresql://researcher:secure_password_change_me@localhost:5432/bitcoin_research
Environment=OLLAMA_URL=http://192.168.1.47:11434

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
